# ==========================================
# TEXTHUMANIZER PRO - PRODUCTION & AD CONFIG
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Google AdSense Monetization (Get from: https://adsense.google.com)
# Example: ca-pub-1234567890123456
GOOGLE_ADSENSE_ID=
GOOGLE_ADSENSE_SLOT_TOP=
GOOGLE_ADSENSE_SLOT_MIDDLE=
GOOGLE_ADSENSE_SLOT_BOTTOM=

# Google Tag (gtag.js) for Google Ads & Analytics (Get from: https://ads.google.com)
# Example: AW-123456789 or G-XXXXXXXXXX
GOOGLE_TAG_ID=

# Master toggle for ad banners (true/false)
MONETIZATION_ENABLED=true

# Optional Custom ads.txt override (defaults to google.com, <pub-id>, DIRECT, f08c47fec0942fa0)
# ADS_TXT_CONTENT=
